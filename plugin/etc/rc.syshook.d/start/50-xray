#!/bin/sh

LOG="/tmp/xray_syshook.log"
LOG_MAX=50000   # ~50 KB — максимальный размер лога перед ротацией (B11)

# B11: ротация лога
if [ -f "$LOG" ]; then
    _size=$(wc -c < "$LOG" 2>/dev/null || echo 0)
    if [ "$_size" -gt "$LOG_MAX" ]; then
        mv -f "$LOG" "${LOG}.0"
    fi
fi

exec >> "$LOG" 2>&1
echo ""
echo "=== xray syshook start: $(date) ==="

XRAY_BIN="/usr/local/bin/xray-core"
T2S_BIN="/usr/local/tun2socks/tun2socks"

# v3.0.0: первый аргумент — inst_uuid конкретного инстанса (опционально)
# Если не задан — обрабатываем все инстансы из config.xml
INST_UUID="${1:-}"

ENABLED=$(php -r 'set_include_path("/usr/local/etc/inc" . PATH_SEPARATOR . get_include_path()); require_once("config.inc"); $cfg = OPNsense\Core\Config::getInstance()->object(); echo (string)($cfg->OPNsense->xray->general->enabled ?? "0");' 2>/dev/null)

echo "enabled=[$ENABLED] inst_uuid=[$INST_UUID]"

[ "$ENABLED" = "1" ] || { echo "xray disabled, exit"; exit 0; }
[ -f "$XRAY_BIN" ]   || { echo "xray-core not found"; exit 0; }

# Функция: настроить TUN для одного инстанса
setup_instance() {
    _INST_UUID="$1"

    # BUG-8 FIX: ожидаем per-instance lock
    _XRAY_LOCK="/var/run/xray_start_${_INST_UUID}.lock"
    _lock_tries=0
    while [ -f "$_XRAY_LOCK" ] && [ $_lock_tries -lt 10 ]; do
        echo "  [${_INST_UUID}] waiting for lock (${_lock_tries}s)..."
        sleep 1
        _lock_tries=$((_lock_tries+1))
    done

    # v4.0.1: чтение параметров инстанса через ConfigBuilder — для raw-инстансов
    # имя TUN и MTU берутся из самого config.json (extractRuntimeFields)
    _INST_INFO=$(_INST_UUID="$_INST_UUID" php -r '
        set_include_path("/usr/local/etc/inc" . PATH_SEPARATOR . get_include_path());
        require_once("config.inc");
        require_once("/usr/local/opnsense/mvc/app/library/OPNsense/Xray/ConfigBuilder.php");
        $cfg  = OPNsense\Core\Config::getInstance()->object();
        $uuid = getenv("_INST_UUID");
        foreach ($cfg->OPNsense->xray->instances->instance as $inst) {
            if ((string)$inst["uuid"] === $uuid) {
                $c = OPNsense\Xray\ConfigBuilder::extractRuntimeFields(
                    OPNsense\Xray\ConfigBuilder::parseInstance($inst));
                echo "TUN_IFACE=" . $c["tun_iface"]  . "\n";
                echo "MTU="       . $c["mtu"]        . "\n";
                echo "DRIVER="    . $c["tun_driver"] . "\n";
                exit(0);
            }
        }
        echo "TUN_IFACE=proxytun2socks0\n";
        echo "MTU=1500\n";
        echo "DRIVER=tun2socks\n";
    ' 2>>"$LOG")

    eval "$_INST_INFO"
    # v4.0.3: '${VAR:-x}' подставляет дефолт и для ПУСТОГО значения — а
    # extractRuntimeFields возвращает пустой tun_iface для raw-конфига без
    # "name" у tun-inbound, из-за чего syshook ждал proxytun2socks0 15 секунд.
    # Дефолт — только если переменная вовсе не установлена (eval не удался).
    TUN_IFACE="${TUN_IFACE-proxytun2socks0}"
    MTU="${MTU-1500}"
    DRIVER="${DRIVER-tun2socks}"

    echo "[${_INST_UUID}] tun=[$TUN_IFACE] mtu=[$MTU] driver=[$DRIVER]"

    # v4.0.1: raw-конфиг без tun-inbound (или без "name") — ждать нечего
    if [ -z "$TUN_IFACE" ]; then
        echo "[${_INST_UUID}] raw config has no tun inbound (or no \"name\" in it) — skipping TUN setup"
        echo "[${_INST_UUID}] hint: add \"name\": \"tunN\" to the tun inbound settings to have this hook track the interface"
        return 0
    fi

    # Ждём TUN интерфейс до 15 секунд (xray создаёт его сам при старте)
    echo "waiting for $TUN_IFACE..."
    i=0
    while [ $i -lt 15 ]; do
        ifconfig "$TUN_IFACE" > /dev/null 2>&1 && break
        sleep 1
        i=$((i+1))
        echo "  ${i}s..."
    done

    ifconfig "$TUN_IFACE" > /dev/null 2>&1 || { echo "[${_INST_UUID}] interface $TUN_IFACE not found after 15s!"; return 0; }

    if [ "$DRIVER" = "xray" ]; then
        # v4.0.0: нативный TUN inbound — xray сам назначает IP (gw+1) и MTU.
        # Здесь только проверка: адрес на интерфейсе должен появиться.
        j=0
        while [ $j -lt 5 ]; do
            _has_ip=$(ifconfig "$TUN_IFACE" 2>/dev/null | grep -c "inet ")
            [ "$_has_ip" -gt 0 ] && break
            sleep 1
            j=$((j+1))
        done
        if [ "$_has_ip" -gt 0 ]; then
            echo "[${_INST_UUID}] $TUN_IFACE is up with an address assigned by xray"
        else
            echo "[${_INST_UUID}] WARNING: $TUN_IFACE has no IP after 5s"
        fi
        return 0
    fi

    # legacy tun2socks: поднимаем интерфейс и назначаем MTU
    ifconfig "$TUN_IFACE" mtu "$MTU" up 2>&1

    # Назначаем IP из OPNsense interfaces (BUG-2 FIX: через env)
    TUN_IP=$(_TUN_IFACE="$TUN_IFACE" php -r '
        set_include_path("/usr/local/etc/inc" . PATH_SEPARATOR . get_include_path());
        require_once("config.inc");
        $cfg = OPNsense\Core\Config::getInstance()->object();
        $tun = getenv("_TUN_IFACE");
        if (empty($tun)) $tun = "proxytun2socks0";
        foreach ($cfg->interfaces->children() as $iface) {
            if ((string)$iface->if === $tun) {
                echo (string)$iface->ipaddr . "/" . (string)$iface->subnet;
                break;
            }
        }
    ' 2>/dev/null)

    if [ -n "$TUN_IP" ]; then
        echo "[${_INST_UUID}] assigning $TUN_IP to $TUN_IFACE..."
        ifconfig "$TUN_IFACE" inet "$TUN_IP" 2>&1
    else
        echo "[${_INST_UUID}] WARNING: no IP found in config, skipping IP assignment"
    fi
}

if [ -n "$INST_UUID" ]; then
    # Обрабатываем конкретный инстанс
    setup_instance "$INST_UUID"
else
    # Обрабатываем все инстансы
    INST_UUIDS=$(php -r '
        set_include_path("/usr/local/etc/inc" . PATH_SEPARATOR . get_include_path());
        require_once("config.inc");
        $cfg = OPNsense\Core\Config::getInstance()->object();
        $instances = $cfg->OPNsense->xray->instances ?? null;
        if ($instances) {
            foreach ($instances->instance as $inst) {
                $uuid    = (string)$inst["uuid"];
                $enabled = (string)$inst->enabled;
                if ($uuid !== "" && $enabled === "1")
                    echo $uuid . "\n";
            }
        }
    ' 2>/dev/null)

    for uuid in $INST_UUIDS; do
        setup_instance "$uuid"
    done
fi

echo "reloading filter..."
/usr/local/sbin/configctl filter reload 2>&1

echo "reconfiguring interfaces..."
/usr/local/sbin/configctl interface reconfigure 2>&1

echo "=== done: $(date) ==="
exit 0
